# Copy this file to .env.local and fill in values when you are ready.
# Never commit real secrets. .env.local is gitignored.

# Required for real AI story generation (optional in Slice 1 — mock fallback runs without it)
OPENAI_API_KEY=

# Supabase Auth (email/password) + future cloud storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — do not expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
